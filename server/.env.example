PORT=3001
NODE_ENV=development
# Transactions require a replica set — use Atlas, docker-compose with replSet,
# or run mongod with --replSet rs0 and rs.initiate() locally.
MONGO_URI=mongodb://localhost:27017/crossval?replicaSet=rs0
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15d
BCRYPT_ROUNDS=10
